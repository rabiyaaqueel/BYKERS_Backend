# ==============================================================================
# BYKERS Backend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ==============================================================================

# Application Environment (dev, test, staging, prod)
ENV=dev

# Database Configuration (PostgreSQL 16 + PostGIS)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/gis_database

# JWT & Security Secrets (Keep private!)
SECRET_KEY=change-this-to-a-secure-secret-key-at-least-32-chars-long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# OTP (One-Time Password) Policy
OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Dev OTP Testing (Only works if ENV=dev and phone is in ALLOWED_TEST_PHONES)
DEV_FIXED_OTP=123456
ALLOWED_TEST_PHONES=+919876543210,+919876543211,+919876543212,+919876543213,+919876543214,+919876543215

# CORS Origins (Comma-separated list or * for dev)
CORS_ORIGINS=*
