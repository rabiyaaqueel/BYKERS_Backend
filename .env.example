# ==============================================================================
# BYKERS Backend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ==============================================================================

# Application Environment (dev, test, staging, prod)
ENV=dev

# Database Configuration (PostgreSQL 18 + PostGIS 3.6)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/bykers_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/bykers_test

# Storage Provider (local for dev/test, azure for staging/prod)
STORAGE_PROVIDER=local

# JWT & Security Secrets (Keep private!)
SECRET_KEY=change-this-to-a-secure-secret-key-at-least-32-chars-long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# OTP (One-Time Password) Policy
OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Dev OTP Testing (Only works if ENV=dev and phone is in ALLOWED_TEST_PHONES)
DEV_FIXED_OTP=123456
ALLOWED_TEST_PHONES=+919876543210,+919876543211,+919876543212,+919876543213,+919876543214,+919876543215

# Real-time SMS Gateway Configuration
# Options for SMS_PROVIDER:
#   - 'console': Logs OTP to server console (default for local dev and CI tests)
#   - 'fast2sms': India real-time SMS delivery to any phone number (https://www.fast2sms.com)
#   - 'twilio': International & Twilio SMS delivery
SMS_PROVIDER=console
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# CORS Origins (Comma-separated list or * for dev)
CORS_ORIGINS=*
